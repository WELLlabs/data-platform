# Stage 1: Builder
FROM python:3.13-alpine AS builder

# Install build dependencies
RUN apk add --no-cache \
    gcc \
    musl-dev \
    libffi-dev \
    curl

# Install uv
RUN pip install --no-cache-dir uv

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

# Stage 2: Runtime
FROM python:3.13-alpine

# Install only runtime dependencies
RUN apk add --no-cache curl

# Install uv
RUN pip install --no-cache-dir uv

# Create non-root user
RUN adduser -D -u 1000 appuser && \
    mkdir -p /app && \
    chown -R appuser:appuser /app

WORKDIR /app

# Copy virtual environment from builder
COPY --chown=appuser:appuser --from=builder /app/.venv /app/.venv

# Copy necessary application files for Flower
COPY --chown=appuser:appuser core/ ./core/
COPY --chown=appuser:appuser tasks/ ./tasks/
COPY --chown=appuser:appuser __init__.py ./
COPY --chown=appuser:appuser flower_entry.py ./

USER appuser

# Expose Flower's default port
EXPOSE 5555

# Run Flower with authentication and broker configuration
# The broker URL will be read from EMAIL_BROKER_URL environment variable
# Basic auth format: username:password (set via FLOWER_BASIC_AUTH env var)
CMD sh -c 'uv run celery -A flower_entry flower --port="${FLOWER_PORT:-5555}" --basic_auth="${FLOWER_BASIC_AUTH:-welllabs:welllabs}"'
