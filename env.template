DOMAIN=https://your-domain.example
LOG_LEVEL=INFO

# Postgresql
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@db:5432/postgres

# Redis
REDIS_URL=redis://redis/0
EMAIL_BROKER_URL=redis://redis/1
EMAIL_RESULT_BACKEND=redis://redis/2
UPLOAD_JOBS_BACKEND=redis://redis/3

# AWS
# leave blank if IAM Role is configured in EC2 instance
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 (presigned URLs are generated by the API; leave AWS keys blank to use an instance IAM role)
S3_REGION=ap-south-1
S3_BUCKET=my-bucket
# Max upload size in bytes (default 50 GiB)
S3_UPLOAD_MAX_SIZE=53687091200
# Presigned URL lifetime in minutes (default 1 day)
S3_UPLOAD_EXP_TIME_MINS=1440
S3_DOWNLOAD_EXP_TIME_MINS=1440

# Backend
SECRET=your-secret-string
COOKIE_NAME=your-cookie-name
COOKIE_MAX_AGE_SECONDS=86400
LONG_TOKEN_AGE_SECONDS=3600
ORGANIZATION_LIST_CACHE_AGE_SECONDS=604800
DATASET_INFO_CACHE_AGE_SECONDS=1800
UPLOAD_JOB_CACHE_AGE_SECONDS=86400
HOMEPAGE_STATS_CACHE_AGE_SECONDS=86400

HOMEPAGE_STATS_RESULT_COUNT=5

# Notifications
EMAIL_GATEWAY_KEY=your-email-service-api-key
EMAIL_SENDER=noreply@your-domain.com
FORGOT_PASSWORD_TEMPLATE_ID=1
VERIFY_EMAIL_TEMPLATE_ID=2
UPLOAD_APPROVAL_TEMPLATE_ID=3
UPLOAD_APPROVAL_RESPONSE_TEMPLATE_ID=4
USER_APPROVAL_REQUEST_TEMPLATE_ID=5
USER_APPROVAL_RESPONSE_TEMPLATE_ID=6
DATASET_TRANSFER_TEMPLATE_ID=7

# Google OAuth (leave blank to hide the Sign in with Google button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Optional: restrict password and Google signup to this email domain (e.g. ifmr.ac.in)
ALLOWED_EMAIL_DOMAIN=

# Celery
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=UTC
CELERY_TASK_DEFAULT_QUEUE=default
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_ACKS_LATE=True
# CELERY_TASK_SOFT_TIME_LIMIT is in seconds (5 minutes)
CELERY_TASK_SOFT_TIME_LIMIT=300
# CELERY_TASK_TIME_LIMIT is in seconds (6 minutes)
CELERY_TASK_TIME_LIMIT=360
CELERY_RESULT_BACKEND_EXPIRES=86400
CELERY_TASK_DEFAULT_RETRY_DELAY=10
CELERY_TASK_MAX_RETRIES=3

# Flower (Celery Monitoring)
FLOWER_BASIC_AUTH=admin:admin
FLOWER_PORT=5555

# Search cache TTL in seconds (default 120 if not set)
SEARCH_CACHE_AGE_SECONDS=600

# Typesense (leave TYPESENSE_HOST blank to use PostgreSQL FTS only)
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=xyz
TYPESENSE_COLLECTION=portal_search
