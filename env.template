# Copy this to .env and fill in the blanks. Keep real secrets out of git.


# Required. The API will not start without these.

# Public site address, for links and cookies. Example: https://data.example.org
DOMAIN=https://your-domain.example
SECRET=your-secret-string
HOST_NAME='Abb. Org Name'

# DB can either be external service or internal container
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@db:5432/postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

S3_BUCKET=my-bucket
S3_REGION=ap-south-1

# Mail worker. Leave the key as a placeholder until you configure Brevo.
EMAIL_GATEWAY_KEY=your-email-service-api-key
EMAIL_SENDER=noreply@your-domain.example

# Leave the Google client blank to hide Sign in with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# (Blank allows every email domain.) enter email domains accepted at sign up. Example: ifmr.ac.in, welllabs.org
ALLOWED_EMAIL_DOMAIN=

COOKIE_NAME=your-cookie-name

# Leave TYPESENSE_HOST blank to search with PostgreSQL only.
TYPESENSE_HOST=typesense
TYPESENSE_API_KEY=xyz


# Optional. Blank or the value shown is fine until you need the feature.

# Leave the AWS keys blank to use an instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AUTO_REMOVE_CONVERTED_FILES=false
CONVERTED_FILES_EXPIRY_TIME_DAYS=30
S3_UPLOAD_MAX_SIZE=53687091200
S3_UPLOAD_EXP_TIME_MINS=1440
S3_DOWNLOAD_EXP_TIME_MINS=1440

# Local web dev only. Example API target: http://localhost:8000
REACT_APP_API_TARGET=
REACT_APP_TITILER_TARGET=
REACT_APP_HOST_NAME=
REACT_APP_HOTS_NAME=

LOG_LEVEL=INFO
COOKIE_MAX_AGE_SECONDS=86400
LONG_TOKEN_AGE_SECONDS=3600

UPLOAD_JOB_CACHE_AGE_SECONDS=86400
ORGANIZATION_LIST_CACHE_AGE_SECONDS=604800
DATASET_INFO_CACHE_AGE_SECONDS=1800
HOMEPAGE_STATS_CACHE_AGE_SECONDS=86400
HOMEPAGE_STATS_RESULT_COUNT=5
SEARCH_CACHE_AGE_SECONDS=600

CELERY_ACCEPT_CONTENT=["json"]
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=UTC
CELERY_TASK_DEFAULT_QUEUE=default
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_ACKS_LATE=True
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=360
CELERY_RESULT_BACKEND_EXPIRES=86400
CELERY_TASK_DEFAULT_RETRY_DELAY=10
CELERY_TASK_MAX_RETRIES=3

TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_COLLECTION=portal_search
TYPESENSE_TAGS_COLLECTION=tags
TYPESENSE_DATA_DIR=/data
TYPESENSE_ENABLE_CORS=true

TITILER_BASE_URL=/titiler
REDIS_URL=redis://redis/0
EMAIL_BROKER_URL=redis://redis/1
EMAIL_RESULT_BACKEND=redis://redis/2
UPLOAD_JOBS_BACKEND=redis://redis/3